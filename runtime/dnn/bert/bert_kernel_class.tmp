// Output:
//	- name: Add_1203_0	type: float	shape: Shape{1, 16, 512, 512}
// Fused functions:
// Broadcast_float_float_cuda_Broadcast_1199<<<dim3(65536, 1, 1), dim3(64, 1, 1), 0, 0>>>(Reshape_1198_0, Broadcast_1199_0);
// Multiply_float_float_float_cuda_Multiply_1200<<<dim3(8192, 1, 1), dim3(512, 1, 1), 0, 0>>>(BatchMatMul_1197_0, Broadcast_1199_0, Multiply_1200_0);
// Broadcast_float_float_cuda_Broadcast_1202<<<dim3(65536, 1, 1), dim3(64, 1, 1), 0, 0>>>(Reshape_1201_0, Broadcast_1202_0);
