// Input:
//	- name: Sum_1160_0	type: float	shape: Shape{1, 512}
//	- name: Constant_1161_0	type: float	shape: Shape{1, 512}
//	- name: Reshape_1164_0	type: float	shape: Shape{1, 1}
// Output:
//	- name: Rsqrt_1167_0	type: float	shape: Shape{1, 512, 1}
// Fused functions:
// Divide_float_float_float_cuda_Divide_1162<<<dim3(1, 1, 1), dim3(512, 1, 1), 0, 0>>>(Sum_1160_0, Constant_1161_0, Divide_1162_0);
// Reshape_float_float_cuda_lib_Reshape_1163(Divide_1162_0, Reshape_1163_0);
// Broadcast_float_float_cuda_Broadcast_1165<<<dim3(8, 1, 1), dim3(64, 1, 1), 0, 0>>>(Reshape_1164_0, Broadcast_1165_0);
// Add_float_float_float_cuda_Add_1166<<<dim3(1, 1, 1), dim3(512, 1, 1), 0, 0>>>(Reshape_1163_0, Broadcast_1165_0, Add_1166_0);
// Rsqrt_float_float_cuda_Rsqrt_1167<<<dim3(1, 1, 1), dim3(512, 1, 1), 0, 0>>>(Add_1166_0, Rsqrt_1167_0);
extern "C" __launch_bounds__(512) __global__ void FusedKernel_float_float_float_float_cuda_Divide_Reshape_Broadcast_Add_Rsqrt_3(float* input0, float* input1, float* input2, float* output0)
{
    int tid = threadIdx.x;
    float temp0 = fdividef(input0[tid], input1[tid]);
    float temp1 = input2[tid % 1];
    float temp2 = add(temp0, temp1);
    float temp3 = rsqrtf(temp2);
    output0[tid] = temp3;

}
